# Copy to .env.local for local development; on Vercel set the same names under
# Project Settings → Environment Variables. Leave the REACT_APP_SUPABASE_* pair
# empty and the app runs in demo mode, keeping everything in the browser.

# Supabase → Project Settings → API. The anon key is public by design; never
# put the service_role key in any REACT_APP_ variable.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Sign-in providers to show besides email, comma separated (google, apple).
# Only list one once it is enabled under Supabase → Authentication → Providers.
REACT_APP_AUTH_PROVIDERS=

# Coach proxy (api/coach.js). The first four are read by the serverless
# function only; never give them a REACT_APP_ prefix. See docs/COACH-PROXY.md.
# Anthropic key the coach uses for athletes without their own; server side only.
ANTHROPIC_API_KEY=
# You.com key (express agent), used only when ANTHROPIC_API_KEY is empty.
YDC_API_KEY=
# Supabase project URL, used by /api/coach to verify the caller's sign-in.
SUPABASE_URL=
# Supabase anon key, used by /api/coach with the URL above to check access tokens.
SUPABASE_ANON_KEY=
# 1 sends every coach message through /api/coach, even when the athlete saved their own key.
REACT_APP_COACH_PROXY=
